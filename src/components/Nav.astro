---
// Shared top navigation. Brand on the left, the three sections on the right.
interface Props { active?: string }
const { active } = Astro.props;
const tabs = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: 'Books', href: '/books' },
];
---
<header class="ti-nav">
  <div class="ti-nav-row">
    <a href="/" class="ti-brand">Shubham Randive</a>
    <nav class="ti-links">
      {tabs.map((t) => (
        <a href={t.href} class={active === t.label ? 'on' : ''}>{t.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .ti-nav {
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    z-index: 10;
  }
  .ti-nav-row {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.25rem;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .ti-brand { font-weight: 700; color: var(--fg); letter-spacing: -0.01em; white-space: nowrap; }
  .ti-brand:hover { text-decoration: none; }
  .ti-links { display: flex; align-items: center; gap: 1.05rem; }
  .ti-links a { color: var(--muted); font-size: 0.94rem; }
  .ti-links a:hover { color: var(--fg); text-decoration: none; }
  .ti-links a.on { color: var(--fg); font-weight: 600; }
  @media (max-width: 620px) {
    .ti-links { gap: 0.85rem; }
  }
</style>
